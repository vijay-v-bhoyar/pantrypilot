# Local file persistence and explicitly simulated payments. No external calls.
APP_ENV=local
STORAGE_MODE=local
PAYMENTS_MODE=simulation
AI_MODE=manual
FINANCIAL_ACTIONS_ENABLED=true
# Hosted: require a random >=32-character secret, Supabase, APP_ENV=hosted.
SESSION_SECRET=
APP_URL=http://127.0.0.1:3100
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Sandbox activation requires explicit authorization. Do not use live credentials.
PROVIDER_ACTIONS_ENABLED=false
# JSON map: profile -> {clientId,secret,merchantId,webhookId,monthlyPlans}. Server only.
PAYPAL_MERCHANTS_JSON=
GEMINI_API_KEY=
# Candidate only: verify account access/free quota and use a rotated key before enabling AI.
GEMINI_MODEL=
AI_DAILY_LIMIT=50
# Hosted limits are persisted in Supabase; failed provider attempts still consume a run.
DEMO_DAILY_LIMIT=100
AI_ACCOUNT_DAILY_LIMIT=40
# Comma-separated operator-approved synthetic workspace UUIDs. Empty denies hosted AI.
PROVIDER_DEMO_WORKSPACE_IDS=
RECONCILE_TOKEN=
# License may be public in a browser but must not be committed without permission.
NEXT_PUBLIC_AG_STUDIO_LICENSE=

# Required before any separately approved model run. Blank denies all model use.
# Hard per-run ceilings: 10 requests, 32768 serialized UTF-8 bytes/request,
# 1024 output tokens/request, 300000 ms. These are not billing/account caps.
AI_MAX_HTTP_REQUESTS=
AI_MAX_INPUT_BYTES=
AI_MAX_OUTPUT_TOKENS=
AI_TIMEOUT_MS=
# Evaluation additionally needs a fresh UUID/dedicated data path and exact config hash.
# EVAL_MAX_HTTP_REQUESTS has a hard ceiling of 120 for the full 12-case session.
RUN_LIVE_EVAL=false
EVAL_RUN_ID=
EVAL_MAX_HTTP_REQUESTS=
EVAL_APPROVED_CONFIG_SHA256=
